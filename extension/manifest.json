{
  "manifest_version": 3,
  "name": "WAPI CRM for WhatsApp Web",
  "version": "1.0.0",
  "description": "Native WhatsApp Web CRM Extension — Sync leads, pipeline stages, follow-ups, and Meta CAPI conversion tracking directly inside web.whatsapp.com.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "styles.css", "icon.png"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
